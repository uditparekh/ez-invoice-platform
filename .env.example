# FastAPI
EZ_API_BASE_URL=http://127.0.0.1:8000
EZ_API_ENVIRONMENT=development
EZ_API_JWT_SECRET=replace-with-a-long-random-secret
EZ_API_ALLOW_DEV_BOOTSTRAP=true

# Local pilot owner
EZ_API_EMAIL=owner@ezinvoice.local
EZ_API_PASSWORD=replace-with-a-long-local-password
EZ_API_FULL_NAME=EZ-Invoice Owner
EZ_ORGANIZATION_NAME=Client Workspace
EZ_INVOICE_BACKEND=api

# QuickBooks sandbox
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:8003/callback
QB_ENVIRONMENT=sandbox
QB_USE_LOCAL_CALLBACK=true

# Zoho Books
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8001/zoho/callback
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3
ZOHO_USE_LOCAL_CALLBACK=true

# Tally
TALLY_URL=http://localhost:9000
