# SiftEntry hosted pilot environment template.
#
# Copy these into your hosting provider's secret/environment settings.
# Do not commit a filled copy.

# Runtime
EZ_API_ENVIRONMENT=pilot
EZ_API_JWT_SECRET=replace-with-64-random-characters
EZ_API_ALLOW_DEV_BOOTSTRAP=false
EZ_API_CORS_ORIGINS=https://app.siftentry.com
EZ_APP_BASE_URL=https://app.siftentry.com
EZ_API_PUBLIC_BASE_URL=https://siftentry-api-production.up.railway.app

# Supabase Postgres
# Use the pooled connection string from Supabase for Railway. Keep this secret
# in Railway only; never expose it to the browser.
EZ_API_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase private PDF storage
# Store original PDFs only for the review window. SiftEntry keeps structured
# invoice JSON, audit logs, hashes, corrections, and posting results in Postgres.
EZ_STORAGE_BACKEND=supabase
EZ_SUPABASE_URL=https://<project-ref>.supabase.co
EZ_SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
EZ_SUPABASE_STORAGE_BUCKET=siftentry-pdf-review
EZ_STORAGE_TIMEOUT_SECONDS=20
SIFTENTRY_PDF_RETENTION_POLICY=review_window
SIFTENTRY_PDF_RETENTION_DAYS=3

# Local-only fallback for laptop smoke tests:
# EZ_API_DATABASE_URL=sqlite:////absolute/path/siftentry.db
# EZ_STORAGE_BACKEND=local
# EZ_API_UPLOAD_DIRECTORY=/absolute/path/uploads

# Email delivery for invite and password reset links.
# Use SMTP credentials from Postmark, SendGrid, Brevo, Amazon SES, or a company relay.
EZ_EMAIL_PROVIDER=smtp
EZ_EMAIL_FROM=SiftEntry <no-reply@siftentry.com>
EZ_EMAIL_REPLY_TO=support@siftentry.com
EZ_SMTP_HOST=smtp.example.com
EZ_SMTP_PORT=587
EZ_SMTP_USERNAME=apikey-or-username
EZ_SMTP_PASSWORD=replace-with-provider-secret
EZ_SMTP_USE_TLS=true

# AI/OCR extraction
# Start the pilot with profile_context. Switch to webhook only after a provider
# service is selected, tested, and covered by client data/privacy terms.
SIFTENTRY_AI_PROVIDER=profile_context
SIFTENTRY_AI_POLICY=review_only
# SIFTENTRY_AI_PROVIDER=webhook
# SIFTENTRY_AI_EXTRACTOR_URL=https://extractor.example.com/siftentry/extract
# SIFTENTRY_AI_EXTRACTOR_TOKEN=replace-with-provider-or-internal-token
SIFTENTRY_AI_TIMEOUT_SECONDS=8
SIFTENTRY_AI_MAX_PAYLOAD_CHARS=120000

# Accounting integrations
QB_ENVIRONMENT=sandbox
QB_REDIRECT_URI=https://app.siftentry.com/callback
ZOHO_REDIRECT_URI=https://app.siftentry.com/zoho/callback

# Vercel frontend variables only:
# NEXT_PUBLIC_APP_NAME=SiftEntry
# EZ_WEB_API_BASE_URL=https://siftentry-api-production.up.railway.app
